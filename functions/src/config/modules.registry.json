              "kpi:activity_counts",
              "filter:type"
            ]
          },
          "loggedBy": {
            "type": "string",
            "description": "UID dell'utente che ha registrato l'attività",
            "tags": [
              "filter:user",
              "kpi:user_activities"
            ]
          },
          "clientId": {
            "type": "string",
            "description": "ID del cliente correlato",
            "tags": [
              "filter:client",
              "relation:clients"
            ]
          },
          "date": {
            "type": "date",
            "description": "Data di svolgimento dell'attività",
            "tags": [
              "filter:date"
            ]
          },
          "createdAt": {
            "type": "datetime",
            "description": "Data di inserimento a sistema ISO 8601",
            "tags": [
              "filter:date",
              "sort:default"
            ]
          }
        }
      }
