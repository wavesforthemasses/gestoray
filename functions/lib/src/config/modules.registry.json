{
    "modules": [
        {
            "id": "places",
            "label": "Gestione Luoghi",
            "description": "Anagrafica dei luoghi fisici, cantieri, sedi operative e destinazioni degli interventi.",
            "icon": "MapPin",
            "requirements": [],
            "path": "/dashboard/places",
            "kpiBridgePath": "/dashboard/places/places.kpi.bridge.ts",
            "clientTabs": [
                {
                    "id": "places",
                    "component": "ClientPlacesTab.svelte",
                    "label": "Luoghi"
                }
            ],
            "settingsCard": {
                "title": "Configurazione Luoghi",
                "description": "Denominazione agnostica (Luogo/Cantiere/Sede Operativa/Destinazione), prefissi numerazione, stati predefiniti.",
                "icon": "MapPin",
                "path": "/dashboard/settings/places"
            },
            "clientQuickAction": {
                "label": "Nuovo Luogo",
                "title": "Crea un nuovo luogo per questo cliente",
                "tab": "places"
            },
            "rolesView": [
                "superadmin",
                "direzione",
                "amministrazione",
                "commerciale",
                "tecnico"
            ],
            "enabled": true,
            "kpiTiles": [
                {
                    "id": "places_attivi",
                    "title": "Luoghi Attivi",
                    "subtitle": "Destinazioni operative attive",
                    "icon": "MapPin",
                    "valueKey": "activePlacesCount",
                    "aggregation": {
                        "collection": "places",
                        "type": "count",
                        "dateFields": [
                            "createdAt",
                            "edits.createdAt",
                            "original.createdAt"
                        ]
                    }
                }
            ],
            "anonymization": {
                "collectionName": "places",
                "linkFieldPath": "clientId",
                "redactFields": [
                    {
                        "fieldPath": "notes",
                        "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
                    }
                ]
            },
            "schema": {
                "fields": {
                    "code": {
                        "type": "string",
                        "description": "Codice identificativo del luogo (es. LUG-2026-001)",
                        "tags": [
                            "search",
                            "sort"
                        ]
                    },
                    "name": {
                        "type": "string",
                        "description": "Nome o denominazione del luogo/cantiere",
                        "tags": [
                            "search",
                            "display"
                        ]
                    },
                    "clientId": {
                        "type": "string",
                        "description": "ID del cliente proprietario/titolare del luogo",
                        "tags": [
                            "filter:client",
                            "relation:clients"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "description": "Stato del luogo (attivo, inattivo)",
                        "tags": [
                            "filter:status",
                            "kpi:places_attivi"
                        ]
                    }
                }
            }
        },
        {
            "id": "projects",
            "label": "Gestione Progetti",
            "description": "Contenitore agnostico di progetti, commesse, avanzamento ed integrazione bridge.",
            "icon": "FolderKanban",
            "requirements": [],
            "path": "/dashboard/projects",
            "kpiBridgePath": "/dashboard/projects/projects.kpi.bridge.ts",
            "clientTabs": [
                {
                    "id": "projects",
                    "component": "ClientProjectsTab.svelte",
                    "label": "Progetti"
                }
            ],
            "settingsCard": {
                "title": "Configurazione Progetti",
                "description": "Denominazione agnostica (Progetto/Cantiere/Commessa/Pratica), prefissi numerazione, stati predefiniti.",
                "icon": "FolderKanban",
                "path": "/dashboard/settings/projects"
            },
            "clientQuickAction": {
                "label": "Nuovo Progetto",
                "title": "Crea un nuovo progetto o contenitore per questo cliente",
                "tab": "projects"
            },
            "rolesView": [
                "superadmin",
                "direzione",
                "amministrazione",
                "commerciale",
                "tecnico"
            ],
            "enabled": true,
            "kpiTiles": [
                {
                    "id": "projects_attivi",
                    "title": "Progetti Attivi",
                    "subtitle": "Contenitori in corso",
                    "icon": "FolderKanban",
                    "valueKey": "activeProjectsCount",
                    "aggregation": {
                        "collection": "projects",
                        "type": "count",
                        "dateFields": [
                            "createdAt",
                            "startDate",
                            "edits.createdAt",
                            "original.createdAt"
                        ]
                    }
                },
                {
                    "id": "portafoglio_lavori",
                    "title": "Portafoglio Lavori",
                    "subtitle": "Valore stimato progetti",
                    "icon": "Briefcase",
                    "valueKey": "totalEstimatedPortfolio",
                    "format": "currency",
                    "aggregation": {
                        "collection": "projects",
                        "type": "sum",
                        "sumFields": [
                            "estimatedAmount",
                            "original.estimatedAmount"
                        ],
                        "dateFields": [
                            "createdAt",
                            "startDate",
                            "edits.createdAt",
                            "original.createdAt"
                        ]
                    }
                }
            ],
            "anonymization": {
                "collectionName": "projects",
                "linkFieldPath": "clientId",
                "redactFields": [
                    {
                        "fieldPath": "notes",
                        "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
                    }
                ]
            },
            "schema": {
                "fields": {
                    "code": {
                        "type": "string",
                        "description": "Codice identificativo del progetto (es. PROG-2026-001)",
                        "tags": [
                            "search",
                            "sort"
                        ]
                    },
                    "name": {
                        "type": "string",
                        "description": "Nome o denominazione del progetto/contenitore",
                        "tags": [
                            "search",
                            "display"
                        ]
                    },
                    "clientId": {
                        "type": "string",
                        "description": "ID del cliente titolare del progetto",
                        "tags": [
                            "filter:client",
                            "relation:clients"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "description": "Stato del progetto (fase_contrattuale, aperto, in_pausa, completato)",
                        "tags": [
                            "filter:status",
                            "kpi:projects_attivi"
                        ]
                    },
                    "progress": {
                        "type": "number",
                        "description": "Percentuale di avanzamento (0-100)",
                        "tags": [
                            "display",
                            "sort"
                        ]
                    },
                    "estimatedAmount": {
                        "type": "currency",
                        "description": "Importo stimato/preventivato di fallback",
                        "tags": [
                            "kpi:portafoglio_lavori"
                        ]
                    }
                }
            }
        },
        {
            "id": "products",
            "label": "Gestione Prodotti",
            "description": "Catalogo prodotti, servizi e listini prezzi",
            "icon": "Package",
            "requirements": [],
            "path": "/dashboard/products",
            "kpiBridgePath": "/dashboard/products/products.kpi.bridge.ts",
            "rolesView": [
                "superadmin",
                "direzione",
                "amministrazione",
                "commerciale",
                "tecnico"
            ],
            "enabled": true,
            "anonymization": {
                "collectionName": "products",
                "linkFieldPath": "id",
                "redactFields": []
            },
            "schema": {
                "fields": {
                    "name": {
                        "type": "string",
                        "description": "Nome del prodotto o servizio",
                        "tags": [
                            "search",
                            "display",
                            "sort"
                        ]
                    },
                    "sku": {
                        "type": "string",
                        "description": "Codice SKU articolo univoco",
                        "tags": [
                            "search",
                            "filter:sku"
                        ]
                    },
                    "category": {
                        "type": "string",
                        "description": "Categoria merceologica del prodotto",
                        "tags": [
                            "filter:category"
                        ]
                    },
                    "price": {
                        "type": "currency",
                        "description": "Prezzo di vendita unitario",
                        "tags": [
                            "kpi:products_price",
                            "filter:price",
                            "sort"
                        ]
                    },
                    "unit": {
                        "type": "string",
                        "description": "Unità di misura (es. pz, kg, ora, m)",
                        "tags": [
                            "display"
                        ]
                    }
                }
            }
        },
        {
            "id": "contracts",
            "label": "Contratti",
            "description": "Gestione contratti e ordini",
            "icon": "FileText",
            "requirements": [
                "products"
            ],
            "path": "/dashboard/contracts",
            "kpiBridgePath": "/dashboard/contracts/contracts.kpi.bridge.ts",
            "clientTabs": [
                {
                    "id": "quotes",
                    "component": "ClientQuotesTab.svelte",
                    "label": "Preventivi & Contratti"
                }
            ],
            "settingsCard": {
                "title": "Configurazione Contratti & Preventivi",
                "description": "Denominazione ufficiale, tipologie abilitate, numerazione automatica, stato predefinito e gestione data scadenza.",
                "icon": "FileText",
                "path": "/dashboard/settings/contracts"
            },
            "clientQuickAction": {
                "label": "Nuovo Preventivo",
                "title": "Nuovo Preventivo per questo cliente",
                "tab": "quotes"
            },
            "rolesView": [
                "superadmin",
                "direzione",
                "amministrazione"
            ],
            "enabled": true,
            "kpiTiles": [
                {
                    "id": "nncf",
                    "title": "NNCF",
                    "subtitle": "Conversioni",
                    "icon": "FileText",
                    "valueKey": "totalNNCF",
                    "commValueKey": "commTotalNNCF",
                    "aggregation": {
                        "collection": "clients",
                        "type": "count",
                        "dateFields": [
                            "derived.nncfDate"
                        ]
                    }
                },
                {
                    "id": "vss",
                    "title": "VSS",
                    "subtitle": "Venduto Netto",
                    "icon": "DollarSign",
                    "valueKey": "totalVenduto",
                    "commValueKey": "commTotalSold",
                    "format": "currency",
                    "aggregation": {
                        "collection": "contracts",
                        "type": "sum",
                        "sumFields": [
                            "totalAmount",
                            "original.totalPrice"
                        ],
                        "dateFields": [
                            "createdAt",
                            "edits.createdAt",
                            "original.createdAt"
                        ],
                        "vendorFields": [
                            "agentId",
                            "original.vendorUid",
                            "original.secondVendorUid"
                        ]
                    }
                }
            ],
            "anonymization": {
                "collectionName": "contracts",
                "linkFieldPath": "original.clientId",
                "redactFields": [
                    {
                        "fieldPath": "notes",
                        "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
                    },
                    {
                        "fieldPath": "clientNotes",
                        "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
                    }
                ]
            },
            "schema": {
                "fields": {
                    "contractNumber": {
                        "type": "string",
                        "description": "Numero sequenziale del contratto (es. CTR-2026-0001)",
                        "tags": [
                            "filter:number",
                            "search",
                            "sort"
                        ]
                    },
                    "title": {
                        "type": "string",
                        "description": "Oggetto o descrizione sintetica del contratto",
                        "tags": [
                            "search",
                            "display"
                        ]
                    },
                    "clientId": {
                        "type": "string",
                        "description": "ID del cliente intestatario del contratto",
                        "tags": [
                            "filter:client",
                            "relation:clients"
                        ]
                    },
                    "clientName": {
                        "type": "string",
                        "description": "Ragione sociale / nome del cliente al momento del salvataggio",
                        "tags": [
                            "search",
                            "display"
                        ]
                    },
                    "agentId": {
                        "type": "string",
                        "description": "UID dell'agente responsabile del contratto",
                        "tags": [
                            "filter:agent",
                            "kpi:user_sales"
                        ]
                    },
                    "totalAmount": {
                        "type": "currency",
                        "description": "Valore totale del contratto al netto degli sconti",
                        "tags": [
                            "kpi:vss",
                            "filter:amount",
                            "chart:aggregate"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "description": "Stato operativo (bozza, inviato, attivo, accettato, in_scadenza, scaduto)",
                        "tags": [
                            "filter:status",
                            "kpi:pending_contracts"
                        ]
                    },
                    "type": {
                        "type": "string",
                        "description": "Tipologia contrattuale (Ricorrente, Non Ricorrente)",
                        "tags": [
                            "filter:type"
                        ]
                    },
                    "createdAt": {
                        "type": "datetime",
                        "description": "Data ISO 8601 di creazione del contratto",
                        "tags": [
                            "filter:date",
                            "sort:default"
                        ]
                    }
                }
            }
        }
    ]
}
