      "kpiBridgePath": "/dashboard/products/products.kpi.bridge.ts",
      "rolesView": [
        "superadmin",
        "direzione",
        "amministrazione",
        "commerciale",
        "tecnico"
      ],
      "enabled": true,
      "kpiTiles": [
        {
          "id": "total_products",
          "title": "Articoli a Catalogo",
          "subtitle": "Prodotti e servizi a catalogo",
          "icon": "Package",
          "valueKey": "total_products",
          "aggregation": {
            "collection": "products",
            "type": "count",
            "dateFields": [
              "createdAt",
              "edits.createdAt",
              "original.createdAt"
            ]
          }
        }
      ],
      "anonymization": {
        "collectionName": "products",
        "linkFieldPath": "id",
        "redactFields": []
      },
      "schema": {
        "fields": {
          "name": {
            "type": "string",
            "description": "Nome del prodotto o servizio",
            "tags": [
              "search",
              "display",
              "sort"
            ]
          },
          "sku": {
            "type": "string",
            "description": "Codice SKU articolo univoco",
            "tags": [
              "search",
              "filter:sku"
            ]
          },
          "category": {
            "type": "string",
            "description": "Categoria merceologica del prodotto",
            "tags": [
              "filter:category"
            ]
          },
          "price": {
            "type": "currency",
            "description": "Prezzo di vendita unitario",
            "tags": [
              "kpi:products_price",
              "filter:price",
              "sort"
            ]
          },
          "unit": {
            "type": "string",
            "description": "Unità di misura (es. pz, kg, ora, m)",
            "tags": [
              "display"
            ]
          }
        }
      }
    },
    {
      "id": "chart",
      "name": "Analytics & Grafici BI",
      "version": "1.0.0",
      "description": "Modulo opzionale per la visualizzazione dinamica dei grafici e trend analitici trasversali",
      "category": "analytics",
      "icon": "TrendingUp",
      "menuItem": null,
      "settingsCard": {
        "path": "/dashboard/settings/chart",
        "title": "Configurazione Analytics & Grafici",
        "description": "Personalizza la posizione delle card KPI, la granularità ed il comportamento dei vari bridge modulari per i grafici.",
        "icon": "TrendingUp"
      }
    },
    {
      "id": "contracts",
      "label": "Contratti",
      "description": "Gestione contratti e ordini",
      "icon": "FileText",
      "requirements": [
        "products"
      ],
      "path": "/dashboard/contracts",
      "kpiBridgePath": "/dashboard/contracts/contracts.kpi.bridge.ts",
      "clientTabs": [
        {
          "id": "quotes",
          "component": "ClientQuotesTab.svelte",
          "label": "Preventivi & Contratti"
        }
      ],
      "settingsCard": {
        "title": "Configurazione Contratti & Preventivi",
        "description": "Denominazione ufficiale, tipologie abilitate, numerazione automatica, stato predefinito e gestione data scadenza.",
        "icon": "FileText",
        "path": "/dashboard/settings/contracts"
      },
      "rolesView": [
        "superadmin",
        "direzione",
        "amministrazione"
      ],
      "enabled": true,
      "kpiTiles": [
        {
          "id": "nncf",
          "title": "NNCF",
          "subtitle": "Conversioni",
          "icon": "FileText",
          "valueKey": "totalNNCF",
          "commValueKey": "commTotalNNCF",
          "aggregation": {
            "collection": "clients",
            "type": "count",
            "dateFields": [
              "derived.nncfDate"
            ]
          }
        },
        {
          "id": "vss",
          "title": "VSS",
          "subtitle": "Venduto Netto",
          "icon": "DollarSign",
          "valueKey": "totalVenduto",
          "commValueKey": "commTotalSold",
          "format": "currency",
          "aggregation": {
            "collection": "contracts",
            "type": "sum",
            "sumFields": [
              "totalAmount",
              "original.totalPrice"
            ],
            "dateFields": [
              "createdAt",
              "edits.createdAt",
              "original.createdAt"
            ],
            "vendorFields": [
              "agentId",
              "original.vendorUid",
              "original.secondVendorUid"
            ]
          }
        }
      ],
      "anonymization": {
        "collectionName": "contracts",
        "linkFieldPath": "clientId",
        "redactFields": [
          {
            "fieldPath": "notes",
            "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
          },
          {
            "fieldPath": "clientNotes",
            "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
          }
        ]
      },
      "schema": {
        "fields": {
          "contractNumber": {
            "type": "string",
            "description": "Numero sequenziale del contratto (es. CTR-2026-0001)",
            "tags": [
              "filter:number",
              "search",
              "sort"
            ]
          },
          "title": {
            "type": "string",
            "description": "Oggetto o descrizione sintetica del contratto",
            "tags": [
              "search",
              "display"
            ]
          },
          "clientId": {
            "type": "string",
            "description": "ID del cliente intestatario del contratto",
            "tags": [
              "filter:client",
              "relation:clients"
            ]
          },
          "clientName": {
            "type": "string",
            "description": "Ragione sociale / nome del cliente al momento del salvataggio",
            "tags": [
              "search",
              "display"
            ]
          },
          "agentId": {
            "type": "string",
            "description": "UID dell'agente responsabile del contratto",
            "tags": [
              "filter:agent",
              "kpi:user_sales"
            ]
          },
          "totalAmount": {
            "type": "currency",
            "description": "Valore totale del contratto al netto degli sconti",
            "tags": [
              "kpi:vss",
              "filter:amount",
              "chart:aggregate"
            ]
          },
          "status": {
            "type": "string",
            "description": "Stato operativo (bozza, inviato, attivo, accettato, in_scadenza, scaduto)",
            "tags": [
              "filter:status",
              "kpi:pending_contracts"
            ]
          },
          "type": {
            "type": "string",
            "description": "Tipologia contrattuale (Ricorrente, Non Ricorrente)",
            "tags": [
              "filter:type"
            ]
          },
          "createdAt": {
            "type": "datetime",
            "description": "Data ISO 8601 di creazione del contratto",
            "tags": [
              "filter:date",
              "sort:default"
            ]
          }
        }
      }
    },
    {
      "id": "activities",
      "label": "Attività",
      "description": "Tracciamento attività commerciali e operative",
      "icon": "ClipboardList",
      "requirements": [],
      "path": "/dashboard/activities",
      "kpiBridgePath": "/dashboard/activities/activities.kpi.bridge.ts",
      "settingsCard": {
        "title": "Configurazione Attività & Task",
        "description": "Configura tipologie attività (chiamate, email, visite, ferie, corsi sicurezza, ecc.), priorità e regole riassegnazione.",
        "icon": "ClipboardList",
        "path": "/dashboard/settings/activities"
      },
      "rolesView": [
        "superadmin",
        "direzione",
        "commerciale",
        "amministrazione",
        "tecnico"
      ],
      "enabled": true,
      "kpiTiles": [
        {
          "id": "activities",
          "title": "Attività",
          "subtitle": "Attività Svolte",
          "icon": "ClipboardList",
          "aggregation": {
            "collection": "activities",
            "type": "count",
            "dateFields": [
              "edits.createdAt",
              "createdAt",
              "original.createdAt"
            ],
            "typeFilterField": "activityTypeId",
            "loggedByFilterField": "assignedUid"
          }
        }
      ],
      "anonymization": {
        "collectionName": "activities",
        "linkFieldPath": "targetId",
        "redactFields": [
          {
            "fieldPath": "description",
            "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
          },
          {
            "fieldPath": "notes",
            "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
          },
          {
            "fieldPath": "targetName",
            "replacement": "ANONIMIZZATO"
          },
          {
            "fieldPath": "targetSubtext",
            "replacement": ""
          }
        ]
      },
      "schema": {
        "fields": {
          "activityNumber": {
            "type": "string",
            "description": "Codice progressivo univoco dell'attività",
            "tags": [
              "search",
              "sort"
            ]
          },
          "title": {
            "type": "string",
            "description": "Oggetto dell'attività",
            "tags": [
              "search",
              "display"
            ]
          },
          "targetType": {
            "type": "string",
            "description": "Tipologia dell'entità bersaglio (contact, client, user, place, vehicle, contract, ticket)",
            "tags": [
              "filter:targetType"
            ]
          },
          "targetId": {
            "type": "string",
            "description": "ID dell'entità bersaglio correlata",
            "tags": [
              "filter:targetId",
              "relation:dynamic"
            ]
          },
          "assignedUid": {
            "type": "string",
            "description": "UID dell'operatore responsabile",
            "tags": [
              "filter:user",
              "kpi:user_activities"
            ]
          },
          "executionDate": {
            "type": "date",
            "description": "Data di svolgimento dell'attività",
            "tags": [
              "filter:date"
            ]
          },
          "status": {
            "type": "string",
            "description": "Stato lavorazione attività (da_fare, in_corso, completata, annullata)",
            "tags": [
              "filter:status"
            ]
          },
          "priority": {
            "type": "string",
            "description": "Priorità attività (bassa, media, alta, urgente)",
            "tags": [
              "filter:priority"
            ]
          }
        }
      }
    },
    {
