{
  "modules": [
    {
      "id": "tickets",
      "label": "Ticket",
      "description": "Gestione ticket e richieste clienti",
      "icon": "Ticket",
      "requirements": [],
      "path": "/dashboard/tickets",
      "kpiBridgePath": "/dashboard/tickets/tickets.kpi.bridge.ts",
      "rolesView": [
        "superadmin",
        "direzione",
        "commerciale",
        "amministrazione",
        "tecnico"
      ],
      "enabled": true,
      "kpiTiles": [
        {
          "id": "ticket_aperti",
          "title": "Ticket Aperti",
          "subtitle": "Ticket aperti o in lavorazione",
          "icon": "Ticket",
          "valueKey": "ticket_aperti",
          "aggregation": {
            "collection": "tickets",
            "type": "count",
            "dateFields": [
              "createdAt",
              "edits.createdAt",
              "original.createdAt"
            ]
          }
        },
        {
          "id": "tmr",
          "title": "Tempo Medio Risoluzione",
          "subtitle": "Ore medie per risoluzione ticket",
          "icon": "Clock",
          "valueKey": "tmr",
          "aggregation": {
            "collection": "tickets",
            "type": "count",
            "dateFields": [
              "createdAt",
              "edits.createdAt",
              "original.createdAt"
            ]
          }
        }
      ],
      "anonymization": {
        "collectionName": "tickets",
        "linkFieldPath": "clientId",
        "redactFields": [
          {
            "fieldPath": "description",
            "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
          },
          {
            "fieldPath": "notes",
            "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
          },
          {
            "fieldPath": "contactName",
            "replacement": "ANONIMIZZATO"
          },
          {
            "fieldPath": "contactPhone",
            "replacement": ""
          }
        ]
      },
      "schema": {
        "fields": {
          "ticketNumber": {
            "type": "string",
            "description": "Numero progressivo del ticket assistenziale",
            "tags": [
              "search",
              "sort"
            ]
          },
          "subject": {
            "type": "string",
            "description": "Oggetto sintesi della richiesta di assistenza",
            "tags": [
              "search",
              "display"
            ]
          },
          "clientId": {
            "type": "string",
            "description": "ID del cliente richiedente",
            "tags": [
              "filter:client",
              "relation:clients"
            ]
          },
          "status": {
            "type": "string",
            "description": "Stato ticket (aperto, in_lavorazione, risolto, chiuso)",
            "tags": [
              "filter:status",
              "kpi:tickets_open"
            ]
          },
          "priority": {
            "type": "string",
            "description": "Livello di priorità (bassa, media, alta, urgente)",
            "tags": [
              "filter:priority"
            ]
          },
          "resolutionTimeHours": {
            "type": "number",
            "description": "Tempo in ore impiegato per la risoluzione",
            "tags": [
              "kpi:tmr"
            ]
          }
        }
      }
    },
    {
      "id": "products",
      "label": "Prodotti",
      "description": "Catalogo prodotti, servizi e listini prezzi",
