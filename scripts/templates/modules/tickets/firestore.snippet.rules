// TICKETS
match /tickets/{docId} {
  allow read: if isAuth() && (
    isAdmin() || 
    isDirezione() || 
    resource.data.assignedTo == request.auth.uid || 
    resource.data.requesterEmail == request.auth.token.email
  );
  allow create: if isAuth();
  allow update: if isAuth() && (
    isAdmin() || 
    isDirezione() || 
    resource.data.assignedTo == request.auth.uid
  );
  allow delete: if hasRole('superadmin');
}
