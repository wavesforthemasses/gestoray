{
  "id": "products",
  "label": "Prodotti",
  "description": "Catalogo prodotti, servizi e listini prezzi",
  "icon": "Package",
  "requirements": [],
  "path": "/dashboard/products",
  "kpiBridgePath": "/dashboard/products/products.kpi.bridge.ts",
  "rolesView": [
    "superadmin",
    "direzione",
    "amministrazione",
    "commerciale",
    "tecnico"
  ],
  "enabled": true,
  "kpiTiles": [
    {
      "id": "total_products",
      "title": "Articoli a Catalogo",
      "subtitle": "Prodotti e servizi a catalogo",
      "icon": "Package",
      "valueKey": "total_products",
      "aggregation": {
        "collection": "products",
        "type": "count",
        "dateFields": [
          "createdAt",
          "edits.createdAt",
          "original.createdAt"
        ]
      }
    }
  ],
  "anonymization": {
    "collectionName": "products",
    "linkFieldPath": "id",
    "redactFields": []
  },
  "schema": {
    "fields": {
      "name": {
        "type": "string",
        "description": "Nome del prodotto o servizio",
        "tags": ["search", "display", "sort"]
      },
      "sku": {
        "type": "string",
        "description": "Codice SKU articolo univoco",
        "tags": ["search", "filter:sku"]
      },
      "category": {
        "type": "string",
        "description": "Categoria merceologica del prodotto",
        "tags": ["filter:category"]
      },
      "price": {
        "type": "currency",
        "description": "Prezzo di vendita unitario",
        "tags": ["kpi:products_price", "filter:price", "sort"]
      },
      "unit": {
        "type": "string",
        "description": "Unità di misura (es. pz, kg, ora, m)",
        "tags": ["display"]
      }
    }
  }
}
