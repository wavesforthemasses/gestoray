{
  "id": "deadlines",
  "label": "Scadenziario & Adempimenti",
  "description": "Monitoraggio scadenze contrattuali, revisioni mezzi, corsi e adempimenti",
  "icon": "Calendar",
  "requirements": [],
  "path": "/dashboard/deadlines",
  "kpiBridgePath": "/dashboard/deadlines/deadlines.kpi.bridge.ts",
  "rolesView": [
    "superadmin",
    "direzione",
    "amministrazione"
  ],
  "enabled": true,
  "kpiTiles": [
    {
      "id": "upcoming_deadlines",
      "title": "Scadenze Imminenti",
      "subtitle": "Adempimenti nei prossimi 30 giorni",
      "icon": "Calendar",
      "valueKey": "upcomingDeadlinesCount",
      "aggregation": {
        "collection": "deadlines",
        "type": "count",
        "dateFields": [
          "expiryDate",
          "createdAt"
        ]
      }
    }
  ],
  "schema": {
    "fields": {
      "title": {
        "type": "string",
        "description": "Oggetto della scadenza",
        "tags": [
          "search",
          "display"
        ]
      },
      "expiryDate": {
        "type": "date",
        "description": "Data di scadenza",
        "tags": [
          "filter:date",
          "sort:default"
        ]
      },
      "status": {
        "type": "string",
        "description": "Stato scadenza (attiva, completata, archiviata)",
        "tags": [
          "filter:status"
        ]
      }
    }
  }
}
