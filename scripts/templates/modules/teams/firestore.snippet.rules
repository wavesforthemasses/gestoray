// TEAMS
match /teams/{teamId} {
  allow read: if isAuth();
  allow create: if isAuth() 
    && (hasRole('superadmin') || isDirezione() || hasRole('manager') || hasRole('amministrazione'))
    && notWritingDerived();
  allow update: if isAuth() 
    && (hasRole('superadmin') || isDirezione() || hasRole('manager') || hasRole('amministrazione'))
    && notWritingDerived();
  allow delete: if hasRole('superadmin') || isDirezione();
}
