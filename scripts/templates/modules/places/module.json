{
  "id": "places",
  "label": "Luoghi",
  "description": "Anagrafica dei luoghi fisici, cantieri, sedi operative, magazzini e geofencing radar.",
  "icon": "MapPin",
  "requirements": [],
  "path": "/dashboard/places",
  "kpiBridgePath": "/dashboard/places/places.kpi.bridge.ts",
  "clientTabs": [
    {
      "id": "places",
      "component": "ClientPlacesTab.svelte",
      "label": "Luoghi"
    }
  ],
  "settingsCard": {
    "title": "Configurazione Luoghi",
    "description": "Denominazione agnostica (Luogo/Cantiere/Sede Operativa/Destinazione), prefissi numerazione, stati predefiniti.",
    "icon": "MapPin",
    "path": "/dashboard/settings/places"
  },
  "rolesView": [
    "superadmin",
    "direzione",
    "amministrazione",
    "commerciale",
    "tecnico"
  ],
  "enabled": true,
  "kpiTiles": [
    {
      "id": "active_places",
      "title": "Cantieri Attivi",
      "subtitle": "Destinazioni operative attive",
      "icon": "CheckCircle2",
      "valueKey": "active_places",
      "aggregation": {
        "collection": "places",
        "type": "count",
        "dateFields": [
          "createdAt",
          "edits.createdAt",
          "original.createdAt"
        ]
      }
    },
    {
      "id": "new_places",
      "title": "Nuove Aperture",
      "subtitle": "Nuovi cantieri e luoghi aperti",
      "icon": "CalendarPlus",
      "valueKey": "new_places",
      "aggregation": {
        "collection": "places",
        "type": "count",
        "dateFields": [
          "createdAt",
          "edits.createdAt",
          "original.createdAt"
        ]
      }
    }
  ],
  "anonymization": {
    "collectionName": "places",
    "linkFieldPath": "clientId",
    "redactFields": [
      {
        "fieldPath": "notes",
        "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
      },
      {
        "fieldPath": "accessInfo.notes",
        "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
      }
    ]
  },
  "schema": {
    "fields": {
      "code": {
        "type": "string",
        "description": "Codice identificativo del luogo (es. LUG-2026-001)",
        "tags": [
          "search",
          "sort"
        ]
      },
      "name": {
        "type": "string",
        "description": "Nome o denominazione del luogo/cantiere",
        "tags": [
          "search",
          "display"
        ]
      },
      "types": {
        "type": "array",
        "description": "Ruoli e tipologie assegnate (site, warehouse, headquarters, branch, store, etc.)",
        "tags": [
          "filter:type"
        ]
      },
      "clientId": {
        "type": "string",
        "description": "ID del cliente proprietario/titolare del luogo",
        "tags": [
          "filter:client",
          "relation:clients"
        ]
      },
      "parentId": {
        "type": "string",
        "description": "ID del luogo genitore nella gerarchia ad albero",
        "tags": [
          "filter:parent",
          "relation:places"
        ]
      },
      "depth": {
        "type": "number",
        "description": "Profondità nell'albero (0 = radice, 1 = sotto-area)",
        "tags": [
          "filter:depth"
        ]
      },
      "status": {
        "type": "string",
        "description": "Stato del luogo (active, temporary, completed, archived)",
        "tags": [
          "filter:status",
          "kpi:places_attivi"
        ]
      }
    }
  }
}