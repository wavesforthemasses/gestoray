match /interventions/{interventionId} {
  allow read: if request.auth != null;
  allow create, update: if request.auth != null;
  allow delete: if request.auth != null && (request.auth.token.role == 'superadmin' || request.auth.token.role == 'direzione');
}
match /teams/{teamId} {
  allow read: if request.auth != null;
  allow create, update, delete: if request.auth != null && (request.auth.token.role == 'superadmin' || request.auth.token.role == 'direzione' || request.auth.token.role == 'amministrazione');
}
match /vehicles/{vehicleId} {
  allow read: if request.auth != null;
  allow create, update, delete: if request.auth != null && (request.auth.token.role == 'superadmin' || request.auth.token.role == 'direzione' || request.auth.token.role == 'amministrazione');
}
match /settings/interventi {
  allow read: if true;
  allow write: if request.auth != null && (request.auth.token.role == 'superadmin' || request.auth.token.role == 'direzione');
}
