{
  "id": "interventi",
  "label": "Interventi Operativi",
  "description": "Gestione interventi tecnici, squadre e consuntivi di campo",
  "icon": "Wrench",
  "requirements": [],
  "path": "/dashboard/interventi",
  "kpiBridgePath": "/dashboard/interventi/interventi.kpi.bridge.ts",
  "rolesView": ["superadmin", "direzione", "amministrazione", "tecnico", "operaio"],
  "enabled": true,
  "anonymization": {
    "collectionName": "interventions",
    "linkFieldPath": "clientId",
    "redactFields": [
      { "fieldPath": "notes", "replacement": "[CONTENUTO ANONIMIZZATO GDPR]" },
      { "fieldPath": "description", "replacement": "[CONTENUTO ANONIMIZZATO GDPR]" }
    ]
  },
  "schema": {
    "fields": {
      "numeroIntervento": {
        "type": "string",
        "description": "Numero progressivo dell'intervento tecnico",
        "tags": ["search", "sort"]
      },
      "clientId": {
        "type": "string",
        "description": "ID del cliente servito",
        "tags": ["filter:client", "relation:clients"]
      },
      "technicianId": {
        "type": "string",
        "description": "UID del tecnico o squadra responsabile",
        "tags": ["filter:technician"]
      },
      "status": {
        "type": "string",
        "description": "Stato intervento (pianificato, in_corso, completato)",
        "tags": ["filter:status", "kpi:interventi_pending"]
      },
      "date": {
        "type": "date",
        "description": "Data programmata dell'intervento",
        "tags": ["filter:date", "sort:default"]
      }
    }
  }
}
