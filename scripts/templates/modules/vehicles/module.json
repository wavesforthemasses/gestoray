  "rolesView": [
    "superadmin",
    "direzione",
    "amministrazione",
    "commerciale",
    "tecnico"
  ],
  "enabled": true,
  "kpiTiles": [
    {
      "id": "vehicles_disponibili",
      "title": "Mezzi Disponibili",
      "subtitle": "Parco mezzi operativo pronto",
      "icon": "Truck",
      "valueKey": "availableVehiclesCount",
      "aggregation": {
        "collection": "vehicles",
        "type": "count",
        "dateFields": [
          "createdAt",
          "edits.createdAt",
          "original.createdAt"
        ]
      }
    }
