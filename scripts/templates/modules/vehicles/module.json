          "search",
          "sort"
        ]
      },
      "name": {
        "type": "string",
        "description": "Marca, modello o nome identificativo del mezzo",
        "tags": [
          "search",
          "display"
        ]
      },
      "licensePlate": {
        "type": "string",
        "description": "Targa del veicolo o numero seriale dello strumento",
        "tags": [
          "search"
        ]
      },
      "type": {
        "type": "string",
        "description": "Tipologia (furgone, autocarro, macchinario, attrezzatura, altro)",
        "tags": [
          "filter:type"
        ]
      },
      "status": {
        "type": "string",
        "description": "Stato operativo (disponibile, in_uso, manutenzione, dismesso)",
        "tags": [
          "filter:status",
          "kpi:vehicles_disponibili"
        ]
      }
    }
  }
