{
  "id": "vehicles",
  "label": "Parco Mezzi & Veicoli",
  "description": "Gestione automezzi aziendali, furgoni, assegnazioni e stato manutenzioni",
  "icon": "Truck",
  "requirements": [],
  "path": "/dashboard/vehicles",
  "kpiBridgePath": "/dashboard/vehicles/vehicles.kpi.bridge.ts",
  "rolesView": [
    "superadmin",
    "direzione",
    "amministrazione",
    "tecnico"
  ],
  "enabled": true,
  "kpiTiles": [
    {
      "id": "available_vehicles",
      "title": "Mezzi Disponibili",
      "subtitle": "Veicoli operativi e pronti all'uso",
      "icon": "Truck",
      "valueKey": "availableVehiclesCount",
      "aggregation": {
        "collection": "vehicles",
        "type": "count",
        "dateFields": [
          "createdAt",
          "edits.createdAt",
          "original.createdAt"
        ]
      }
    }
  ],
  "schema": {
    "fields": {
      "plate": {
        "type": "string",
        "description": "Targa del veicolo",
        "tags": [
          "search",
          "display",
          "sort"
        ]
      },
      "model": {
        "type": "string",
        "description": "Modello e marca del mezzo",
        "tags": [
          "search",
          "display"
        ]
      },
      "status": {
        "type": "string",
        "description": "Stato del mezzo (disponibile, in_uso, in_manutenzione)",
        "tags": [
          "filter:status",
          "kpi:available_vehicles"
        ]
      }
    }
  }
}
