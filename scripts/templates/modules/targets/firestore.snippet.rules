// TARGETS & BUDGETING
match /targets_plans/{planId} {
  allow read: if isAuth();
  allow write: if isAuth() && (isAdmin() || isDirezione());
}

match /targets_records/{recordId} {
  allow read: if isAuth();
  allow create: if isAuth() && (
    isAdmin() || isDirezione() ||
    (request.resource.data.subjectType == 'user' && request.resource.data.subjectId == request.auth.uid)
  );
  allow update: if isAuth() && (
    isAdmin() || isDirezione() ||
    (resource.data.subjectType == 'user' && resource.data.subjectId == request.auth.uid)
  );
  allow delete: if isAuth() && (isAdmin() || isDirezione());
}

match /settings/targets {
  allow read: if isAuth();
  allow write: if isAuth() && (isAdmin() || isDirezione());
}
