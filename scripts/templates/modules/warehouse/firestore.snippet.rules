// WAREHOUSE & INVENTORY
match /suppliers/{supplierId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if isAuth() && notWritingDerived();
  allow delete: if hasRole('superadmin') || isDirezione() || isAdmin();
}

match /purchase_orders/{poId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if isAuth() && notWritingDerived();
  allow delete: if hasRole('superadmin') || isDirezione() || isAdmin();
}

match /warehouse_inventory/{invId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if isAuth() && notWritingDerived();
  allow delete: if hasRole('superadmin') || isDirezione() || isAdmin();
}

match /stock_movements/{movId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if false; // Immutable ledger movement
  allow delete: if hasRole('superadmin');
}

match /warehouse_movements/{movId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if false; // Immutable ledger movement
  allow delete: if hasRole('superadmin');
}
