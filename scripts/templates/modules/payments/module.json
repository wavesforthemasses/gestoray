{
  "id": "payments",
  "label": "Incassi & Cassa",
  "description": "Registro incassi, flussi di cassa, scorporo IVA e riconciliazione",
  "icon": "CreditCard",
  "requirements": [],
  "path": "/dashboard/payments",
  "kpiBridgePath": "/dashboard/payments/payments.kpi.bridge.ts",
  "settingsCard": {
    "title": "Configurazione Incassi & Cassa",
    "description": "Denominazione agnostica (Incasso/Ricevuta/Entrata), prefissi numerazione, aliquote IVA predefinite.",
    "icon": "CreditCard",
    "path": "/dashboard/settings/payments"
  },
  "rolesView": [
    "superadmin",
    "direzione",
    "amministrazione"
  ],
  "enabled": true,
  "kpiTiles": [
    {
      "id": "total_incassato",
      "title": "Totale Incassato",
      "subtitle": "Imponibile netto incassato",
      "icon": "CreditCard",
      "format": "currency",
      "isCurrency": true,
      "valueKey": "totalIncassato",
      "aggregation": {
        "collection": "payments",
        "type": "sum",
        "sumFields": [
          "netAmount",
          "original.netAmount",
          "grossAmount",
          "original.amount"
        ],
        "dateFields": [
          "paymentDate",
          "createdAt",
          "original.date"
        ]
      }
    },
    {
      "id": "incassato_contratti",
      "title": "Incassato Contratti",
      "subtitle": "Quote incassate imputate a contratti (GI)",
      "icon": "Wallet",
      "format": "currency",
      "isCurrency": true,
      "valueKey": "incassatoContratti",
      "aggregation": {
        "collection": "payments",
        "type": "sum",
        "sumFields": [
          "contractAllocations.amount"
        ],
        "dateFields": [
          "paymentDate",
          "createdAt"
        ]
      }
    }
  ],
  "anonymization": {
    "collectionName": "payments",
    "linkFieldPath": "clientId",
    "redactFields": [
      {
        "fieldPath": "notes",
        "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
      }
    ]
  },
  "schema": {
    "fields": {
      "paymentNumber": {
        "type": "string",
        "description": "Numero progressivo del movimento di incasso (es. INC-2026-0001)",
        "tags": [
          "filter:number",
          "search",
          "sort"
        ]
      },
      "clientId": {
        "type": "string",
        "description": "ID del cliente pagatore",
        "tags": [
          "filter:client",
          "relation:clients"
        ]
      },
      "clientName": {
        "type": "string",
        "description": "Ragione sociale del cliente pagatore",
        "tags": [
          "search",
          "display"
        ]
      },
      "grossAmount": {
        "type": "currency",
        "description": "Importo lordo totale incassato",
        "tags": [
          "kpi:gross_amount",
          "filter:amount"
        ]
      },
      "netAmount": {
        "type": "currency",
        "description": "Imponibile netto reale (base calcolo provvigioni)",
        "tags": [
          "kpi:net_amount",
          "filter:amount"
        ]
      },
      "vatRate": {
        "type": "number",
        "description": "Aliquota IVA percentuale applicata (es. 22%)",
        "tags": [
          "filter:vat"
        ]
      },
      "paymentDate": {
        "type": "date",
        "description": "Data effettiva dell'incasso",
        "tags": [
          "filter:date",
          "sort:default"
        ]
      },
      "method": {
        "type": "string",
        "description": "Metodo di pagamento (bonifico, contanti, carta, assegno, etc.)",
        "tags": [
          "filter:method"
        ]
      },
      "status": {
        "type": "string",
        "description": "Stato movimento (registrato, in_verifica, annullato)",
        "tags": [
          "filter:status"
        ]
      }
    }
  }
}
