{
  "id": "scheduling",
  "label": "Pianificazione & Interventi",
  "description": "Agenda interventi di campo, planning cantieri e assegnazione risorse",
  "icon": "CalendarDays",
  "requirements": [],
  "path": "/dashboard/scheduling",
  "kpiBridgePath": "/dashboard/scheduling/scheduling.kpi.bridge.ts",
  "rolesView": [
    "superadmin",
    "direzione",
    "tecnico"
  ],
  "enabled": true,
  "kpiTiles": [
    {
      "id": "active_scheduling",
      "title": "Pianificazioni Attive",
      "subtitle": "Interventi programmati in agenda",
      "icon": "CalendarDays",
      "valueKey": "activeSchedulingCount",
      "aggregation": {
        "collection": "interventions",
        "type": "count",
        "dateFields": [
          "scheduledDate",
          "createdAt"
        ]
      }
    }
  ],
  "schema": {
    "fields": {
      "title": {
        "type": "string",
        "description": "Titolo intervento o attività pianificata",
        "tags": [
          "search",
          "display"
        ]
      },
      "scheduledDate": {
        "type": "date",
        "description": "Data pianificata",
        "tags": [
          "filter:date",
          "sort:default"
        ]
      }
    }
  }
}
