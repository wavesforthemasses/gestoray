{
  "id": "invoices",
  "label": "Fatture & Documenti",
  "description": "Emissione e gestione fatture ordinarie, differite da bolle, acconti e note di credito",
  "icon": "Receipt",
  "requirements": ["vat"],
  "path": "/dashboard/invoices",
  "kpiBridgePath": "/dashboard/invoices/invoices.kpi.bridge.ts",
  "rolesView": [
    "superadmin",
    "direzione",
    "amministrazione",
    "commerciale"
  ],
  "enabled": true,
  "kpiTiles": [
    {
      "id": "fatturato_mese",
      "title": "Fatturato Mese",
      "subtitle": "Totale imponibile emesso nel mese",
      "icon": "Receipt",
      "valueKey": "fatturato_mese",
      "aggregation": {
        "collection": "invoices",
        "type": "sum",
        "field": "totalNet",
        "dateFields": [
          "date",
          "createdAt"
        ]
      }
    },
    {
      "id": "iva_debito_mese",
      "title": "IVA a Debito",
      "subtitle": "Totale IVA esigibile del mese",
      "icon": "Percent",
      "valueKey": "iva_debito_mese",
      "aggregation": {
        "collection": "invoices",
        "type": "sum",
        "field": "totalVat",
        "dateFields": [
          "date",
          "createdAt"
        ]
      }
    },
    {
      "id": "fatture_aperte",
      "title": "Fatture da Incassare",
      "subtitle": "Fatture emesse non ancora saldate",
      "icon": "Clock",
      "valueKey": "fatture_aperte",
      "aggregation": {
        "collection": "invoices",
        "type": "count",
        "dateFields": [
          "date",
          "createdAt"
        ]
      }
    }
  ],
  "anonymization": {
    "collectionName": "invoices",
    "linkFieldPath": "clientId",
    "redactFields": [
      {
        "fieldPath": "notes",
        "replacement": "[CONTENUTO ANONIMIZZATO GDPR]"
      },
      {
        "fieldPath": "clientName",
        "replacement": "CLIENTE ANONIMIZZATO"
      },
      {
        "fieldPath": "vatNumber",
        "replacement": ""
      },
      {
        "fieldPath": "taxCode",
        "replacement": ""
      },
      {
        "fieldPath": "pec",
        "replacement": ""
      },
      {
        "fieldPath": "sdiCode",
        "replacement": ""
      },
      {
        "fieldPath": "address",
        "replacement": "[INDIRIZZO ANONIMIZZATO]"
      }
    ]
  },
  "schema": {
    "fields": {
      "invoiceNumber": {
        "type": "string",
        "description": "Numero progressivo ufficiale e sezionale della fattura",
        "tags": [
          "search",
          "sort",
          "display"
        ]
      },
      "type": {
        "type": "string",
        "description": "Tipologia documento Fiscale (TD01, TD02, TD04, TD24, TD06)",
        "tags": [
          "filter:type",
          "display"
        ]
      },
      "clientId": {
        "type": "string",
        "description": "ID del cliente destinatario",
        "tags": [
          "filter:client",
          "relation:clients"
        ]
      },
      "clientName": {
        "type": "string",
        "description": "Denominazione o Ragione Sociale del cliente",
        "tags": [
          "search",
          "display"
        ]
      },
      "date": {
        "type": "date",
        "description": "Data di emissione del documento fiscale",
        "tags": [
          "filter:date",
          "sort:default"
        ]
      },
      "totalGross": {
        "type": "number",
        "description": "Totale lordo del documento inclusa IVA",
        "tags": [
          "display",
          "kpi:total_revenue"
        ]
      },
      "status": {
        "type": "string",
        "description": "Stato del ciclo di vita (bozza, emessa, inviata_sdi, consegnata, pagata)",
        "tags": [
          "filter:status"
        ]
      }
    }
  }
}
