rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function getTenantId() {
      return (request.auth != null && request.auth.token != null && 'tenantId' in request.auth.token)
        ? request.auth.token.tenantId
        : 'default';
    }

    function hasRole(role) {
      return request.auth != null && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role == role) ||
        (request.auth.token != null && 'roles' in request.auth.token && request.auth.token.roles.hasAny([role])) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            ('original' in getUserData() && 'roles' in getUserData().original && getUserData().original.roles.hasAny([role])) ||
            ('roles' in getUserData() && getUserData().roles.hasAny([role])) ||
            ('role' in getUserData() && getUserData().role == role)
          )
        )
      );
    }
    
    function isAuth() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return hasRole('superadmin') || hasRole('amministrazione');
    }

    function isDirezione() {
      return hasRole('direzione');
    }
    
    function notWritingDerived() {
      return (request.resource == null) ||
             !('derived' in request.resource.data) ||
             ((resource == null || !('derived' in resource.data)) && 
                request.resource.data.derived.keys().hasOnly(['textSearch', 'cacheChunkId', 'activitiesCount', 'placesCount', 'contractCount', 'ticketsCount', 'deleted', 'isNNCF', 'nncfDate', 'nncfOrderId', 'nncfVendorUid'])) ||
             (resource != null && ('derived' in resource.data) && (
                request.resource.data.derived == resource.data.derived ||
                request.resource.data.derived.diff(resource.data.derived).affectedKeys().hasOnly(['textSearch', 'cacheChunkId', 'activitiesCount', 'placesCount', 'contractCount', 'ticketsCount', 'deleted', 'isNNCF', 'nncfDate', 'nncfOrderId', 'nncfVendorUid'])
             ));
    }
    
    // USERS
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow delete: if hasRole('superadmin');
    }

    // VEHICLES
    match /vehicles/{vehicleId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (isAdmin() || isDirezione());
    }

    // DEADLINES
    match /deadlines/{deadlineId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth();
    }

    // ACTIVITIES
    match /activities/{activityId} {
      allow read, write: if isAuth();
    }
    
    // CLIENTS
    match /clients/{clientId} {
      allow read: if isAuth();
      allow create: if isAuth() && notWritingDerived();
      allow update: if isAuth() && notWritingDerived();
      allow delete: if hasRole('superadmin');
      
      match /activities/{activityId} {
        allow read, write: if isAuth();
      }

      match /locations/{locationId} {
        allow read, write: if isAuth();
      }

      match /history/{histId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if false;
        allow delete: if hasRole('superadmin');
      }
    }
    
    // CONTACTS
    match /contacts/{contactId} {
      allow read: if isAuth();
      allow create: if isAuth() && notWritingDerived();
      allow update: if isAuth() && notWritingDerived();
      allow delete: if isAuth();
    }

    // QUALIFICATIONS
    match /qualifications/{qualId} {
      allow read: if isAuth();
      allow create, update, delete: if hasRole('superadmin');
    }

    // SETTINGS
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAuth() && (hasRole('superadmin') || isDirezione() || isAdmin());
    }

    // LOGIN PINS
    match /login_pins/{email} {
      allow read, write: if false;
    }

    // SYSTEM CONFIG & TENANT FEATURES
    match /system_config/{configId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // SYSTEM CACHE (Principio 8 - Zero Cache Poisoning)
    match /system_cache/{cacheId} {
      allow read: if isAuth();
      allow write: if isAuth() && (isAdmin() || isDirezione());
    }

    // CUSTOM FIELDS
    match /custom_fields/{fieldId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // UNITS OF MEASURE
    match /units_of_measure/{unitId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isDirezione();
    }

    // SYSTEM TAGS
    match /system_tags/{tagId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && request.resource.data.name is string && request.resource.data.name.size() < 50;
      allow delete: if isAdmin() || isDirezione();
    }

    // SYSTEM IMPORT LOGS
    match /system_import_logs/{logId} {
      allow read, write: if isAdmin() || isDirezione();
    }

    // NOTIFICATIONS
    match /notifications/{notifId} {
      allow read: if isAuth() && (resource.data.recipientId == request.auth.uid || isAdmin() || isDirezione());
      allow create: if isAuth() && (request.resource.data.recipientId == request.auth.uid || isAdmin() || isDirezione());
      allow update: if isAuth() && (resource.data.recipientId == request.auth.uid || isAdmin() || isDirezione());
      allow delete: if isAuth() && (resource.data.recipientId == request.auth.uid || isAdmin() || isDirezione());
    }

    // ANALYTICS & MATERIALIZED VIEWS
    match /analytics_monthly/{monthDoc} {
      allow read: if isAuth();
      allow write: if false;

      match /{subcollection=**} {
        allow read: if isAuth();
        allow write: if false;
      }
    }

    // --- MODULE: tickets BEGIN ---
    // TICKETS
match /tickets/{docId} {
  allow read: if isAuth();
  allow create: if isAuth();
  allow update: if isAuth();
  allow delete: if hasRole('superadmin');
}
    // --- MODULE: tickets END ---

    // --- MODULE: contracts BEGIN ---
    // CONTRACTS & INSTALLMENTS
match /contracts/{contractId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if isAuth() && notWritingDerived();
  allow delete: if hasRole('superadmin');
}

match /{path=**}/installments/{instId} {
  allow read: if isAuth();
  allow write: if isAuth();
}
    // =========================================================================
    // SYSTEM LEDGER & VERSIONING (IMMUTABLE MUTATION TRAIL & CONCURRENCY)
    // =========================================================================
    match /system_ledger/{entryId} {
      allow read: if isAuth() 
        && (hasRole('superadmin') || resource.data.tenantId == getTenantId());
      
      allow create: if isAuth()
        && request.resource.data.tenantId == getTenantId()
        && request.resource.data.actorType == 'USER'
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.timestamp == request.time
        && request.resource.data.module is string
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && request.resource.data.baseVersion is int
        && request.resource.data.aggregateVersion is int
        && request.resource.data.aggregateVersion == request.resource.data.baseVersion + 1
        && request.resource.data.keysChanged is list
        && request.resource.data.mutations is map
        && request.resource.data.dateInt is int
        && (
          request.resource.data.eventType != 'REVERSAL' || 
          hasRole('superadmin')
        )
        && (
          !('isForced' in request.resource.data) || 
          (request.resource.data.isForced == true && hasRole('superadmin') && request.resource.data.forcedBy == request.auth.uid)
        );
        
      allow update, delete: if false;
    }

    // =========================================================================
    // SYSTEM LEDGER REVERSALS (ATOMIC IDEMPOTENCY MARKERS)
    // =========================================================================
    match /system_ledger_reversals/{targetEntryId} {
      allow read: if isAuth() 
        && (hasRole('superadmin') || resource.data.tenantId == getTenantId());

      allow create: if isAuth()
        && hasRole('superadmin')
        && request.resource.data.tenantId == getTenantId()
        && request.resource.data.reversedBy == request.auth.uid
        && request.resource.data.reversedAt == request.time;

      allow update, delete: if false;
    }

    // --- MODULE: products BEGIN ---
    // PRODUCTS
match /products/{docId} {
  allow read: if isAuth();
  allow create, update: if isAuth();
  allow delete: if hasRole('superadmin') || isDirezione() || isAdmin();
}
    // --- MODULE: products END ---

    // --- MODULE: activities BEGIN ---
    // ACTIVITIES
match /{path=**}/activities/{docId} {
  allow read: if isAuth();
  allow write: if isAuth();
}
match /activity_types/{docId} {
  allow read: if isAuth();
  allow write: if isAdmin();
}
    // --- MODULE: activities END ---

    // --- MODULE: teams BEGIN ---
    // TEAMS
match /teams/{teamId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if isAuth() && notWritingDerived();
  allow delete: if hasRole('superadmin') || isDirezione();
}
    // --- MODULE: teams END ---

    // --- MODULE: places BEGIN ---
    // PLACES
match /places/{placeId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if isAuth() && notWritingDerived();
  allow delete: if hasRole('superadmin') || isDirezione() || isAdmin();
}
match /place_presences/{logId} {
  allow read: if isAuth();
  allow create, update: if isAuth() && notWritingDerived();
  allow delete: if hasRole('superadmin') || isDirezione() || isAdmin();
}
match /user_active_presences/{userId} {
  allow read, write: if isAuth();
}
match /unique_keys/{keyId} {
  allow read: if isAuth();
  allow create, delete: if isAuth();
  allow update: if false;
}
    // --- MODULE: places END ---

    // --- MODULE: payments BEGIN ---
    // PAYMENTS & FLUSSI DI CASSA
    match /payments/{paymentId} {
      allow read: if isAuth();
      allow create: if isAuth() && notWritingDerived();
      allow update: if isAuth() && notWritingDerived();
      allow delete: if hasRole('superadmin') || isAdmin();

      match /{path=**}/contractsPaid/{allocId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
    }

    match /{path=**}/contractsPaid/{allocId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
    // --- MODULE: payments END ---

    // --- MODULE: targets BEGIN ---
    // TARGETS & BUDGETING
match /targets_plans/{planId} {
  allow read: if isAuth();
  allow write: if isAuth() && (isAdmin() || isDirezione());
}

match /targets_records/{recordId} {
  allow read: if isAuth();
  allow create: if isAuth() && (
    isAdmin() || isDirezione() ||
    (request.resource.data.subjectType == 'user' && request.resource.data.subjectId == request.auth.uid)
  );
  allow update: if isAuth() && (
    isAdmin() || isDirezione() ||
    (resource.data.subjectType == 'user' && resource.data.subjectId == request.auth.uid)
  );
  allow delete: if isAuth() && (isAdmin() || isDirezione());
}

match /settings/targets {
  allow read: if isAuth();
  allow write: if isAuth() && (isAdmin() || isDirezione());
}
    // --- MODULE: targets END ---

    // --- MODULE: warehouse BEGIN ---
    // WAREHOUSE & INVENTORY
match /suppliers/{supplierId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if isAuth() && notWritingDerived();
  allow delete: if hasRole('superadmin') || isDirezione() || isAdmin();
}

match /purchase_orders/{poId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if isAuth() && notWritingDerived();
  allow delete: if hasRole('superadmin') || isDirezione() || isAdmin();
}

match /warehouse_inventory/{invId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if isAuth() && notWritingDerived();
  allow delete: if hasRole('superadmin') || isDirezione() || isAdmin();
}

match /stock_movements/{movId} {
  allow read: if isAuth();
  allow create: if isAuth() && notWritingDerived();
  allow update: if false; // Immutable ledger movement
  allow delete: if hasRole('superadmin');
}
    // --- MODULE: warehouse END ---
  }
}

