rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function hasRole(role) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.original.roles.hasAny([role]);
    }
    
    function isAuth() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return hasRole('superadmin') || hasRole('amministrazione');
    }

    function isDirezione() {
      return hasRole('direzione');
    }
    
    // Blocca scrittura frontend su derived, ad eccezione di textSearch che viene aggiornato dal frontend
    function notWritingDerived() {
      return (request.resource == null) ||
             !('derived' in request.resource.data) ||
             (resource != null && (
                request.resource.data.derived == resource.data.derived ||
                request.resource.data.derived.diff(resource.data.derived).affectedKeys().hasOnly(['textSearch'])
             ));
    }
    
    // USERS
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow delete: if hasRole('superadmin');
    }
    
    // CLIENTS
    match /clients/{clientId} {
      allow read: if isAuth() && (isAdmin() || isDirezione() || resource.data.original.createdBy == request.auth.uid);
      allow create: if isAuth() && notWritingDerived();
      allow update: if isAuth() && notWritingDerived() && (isAdmin() || isDirezione() || resource.data.original.createdBy == request.auth.uid);
      allow delete: if hasRole('superadmin');
      
      match /history/{histId} {
        allow read: if isAuth() && (isAdmin() || isDirezione() || get(/databases/$(database)/documents/clients/$(clientId)).data.original.createdBy == request.auth.uid);
        allow create: if isAuth();
        allow update: if false;  // audit trail immutabile per update
        allow delete: if hasRole('superadmin'); // permesso superadmin per cancellazione cliente
      }
    }
    
    // QUALIFICATIONS
    match /qualifications/{qualId} {
      allow read: if isAuth();
      allow create, update, delete: if hasRole('superadmin');
    }

    // SETTINGS
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAuth() && (hasRole('superadmin') || isDirezione() || isAdmin());
    }

    // LOGIN PINS — solo server-side
    match /login_pins/{email} {
      allow read, write: if false;
    }
  }
}
