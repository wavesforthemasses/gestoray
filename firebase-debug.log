} {\n  allow read: if isAuth();\n  allow create: if isAuth() && notWritingDerived();\n  allow update: if isAuth() && notWritingDerived();\n  allow delete: if hasRole('superadmin') || isDirezione();\n}\n    // --- MODULE: projects END ---\n  }\n}\n"}]}}
