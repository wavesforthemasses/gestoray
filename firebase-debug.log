[debug] [2026-07-23T14:26:27.402Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/gesto-ray:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    function hasRole(role) {\n      return request.auth != null && \n             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.original.roles.hasAny([role]);\n    }\n    \n    function isAuth() {\n      return request.auth != null;\n    }\n    \n    function isAdmin() {\n      return hasRole('superadmin') || hasRole('amministrazione');\n    }\n\n    function isDirezione() {\n      return hasRole('direzione');\n    }\n    \n    // Blocca scrittura frontend su derived, ad eccezione di textSearch che viene aggiornato dal frontend\n    function notWritingDerived() {\n      return (request.resource == null) ||\n             !('derived' in request.resource.data) ||\n             (resource != null && (\n                request.resource.data.derived == resource.data.derived ||\n                request.resource.data.derived.diff(resource.data.derived).affectedKeys().hasOnly(['textSearch'])\n             ));\n    }\n    \n    // USERS\n    match /users/{uid} {\n      allow read: if isAuth(); // Permesso a tutti per vedere le anagrafiche venditori nei dropdown\n      allow create: if isAdmin();\n      allow update: if isAuth() && (request.auth.uid == uid || isAdmin());\n      allow delete: if hasRole('superadmin');\n    }\n    \n    // CLIENTS\n    match /clients/{clientId} {\n      allow read: if isAuth() && (isAdmin() || isDirezione() || resource.data.original.createdBy == request.auth.uid);\n      allow create: if isAuth() && notWritingDerived();\n      allow update: if isAuth() && notWritingDerived() && (isAdmin() || isDirezione() || resource.data.original.createdBy == request.auth.uid);\n      allow delete: if hasRole('superadmin');\n      \n      match /history/{histId} {\n        allow read: if isAuth() && (isAdmin() || isDirezione() || get(/databases/$(database)/documents/clients/$(clientId)).data.original.createdBy == request.auth.uid);\n        allow create: if isAuth();\n        allow update: if false;  // audit trail immutabile per update\n        allow delete: if hasRole('superadmin'); // permesso superadmin per cancellazione cliente\n      }\n    }\n    \n    // QUALIFICATIONS\n    match /qualifications/{qualId} {\n      allow read: if isAuth();\n      allow create, update, delete: if hasRole('superadmin');\n    }\n\n    // SETTINGS\n    match /settings/{settingId} {\n      allow read: if isAuth();\n      allow write: if isAuth() && (hasRole('superadmin') || isDirezione() || isAdmin());\n    }\n\n    // LOGIN PINS — solo server-side\n    match /login_pins/{email} {\n      allow read, write: if false;\n    }\n\n    // CONTRACTS\n    match /contracts/{docId} {\n      allow read: if isAuth();\n      allow write: if isAdmin();\n    }\n  }\n}\n"}]}}
